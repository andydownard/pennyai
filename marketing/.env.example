# ───────────────────────────────────────────────────────────
# Groflo Marketing — server environment variables
# ───────────────────────────────────────────────────────────

# Postgres connection string (Rally project's Postgres-mpxU service).
# In Railway production this should reference the shared-with-pennyai DB
# so the marketing signup funnel writes to the same place as the app.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Salt for hashing client IPs in campaign_leads (rate-limit bookkeeping).
# Pick any random string — rotating it resets per-IP buckets.
IP_HASH_SALT=change-me-in-production

# Server port (Railway injects PORT automatically)
PORT=8080

# ───────────────────────────────────────────────────────────
# App URL (the Penny consumer app)
# Staging: https://penny-staging.up.railway.app
# Production: https://app.groflo.io
VITE_APP_URL=https://app.groflo.io

# Brand portal URL (where campaign-signup hands off after brief submission)
# Production: https://brands.groflo.io
VITE_BRAND_PORTAL_URL=https://brands.groflo.io
BRAND_PORTAL_URL=https://brands.groflo.io
