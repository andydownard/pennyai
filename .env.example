TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_PHONE=xxxxxxxxxx
LOGODEV_TOKEN=pk_xxxxxxxxxxxxxxxx
LOGODEV_SECRET=sk_xxxxxxxxxxxxxxxx
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NPS_INTERVAL_DAYS=90
PORT=8080
DB_PATH=thriftly.db
# Note: DB_PATH retains the historical "thriftly.db" filename. The product is
# Groflo; the file is just a name. Renaming would break the Litestream chain.
# TIMPAGER_URL — Rally platform URL for auth bridge + revenue events.
#   Also the Rally identity authority: REQUIRED for Rally sign-in, which resolves
#   every Clerk identity against POST {TIMPAGER_URL}/api/v1/identity/resolve.
# TIMPAGER_API_KEY — service key for timpager. Posted as the X-API-Key header
#   (never as Authorization: Bearer — timpager would then treat the call as a
#   legacy body-only resolve). Required for Rally sign-in.
TIMPAGER_URL=
TIMPAGER_API_KEY=

# =============================================================================
# RALLY SIGN-IN (CLERK SATELLITE) — ships dark, default OFF
#
# pennyai is a Clerk SATELLITE DAUGHTER of the Rally primary instance that lives
# in timpager. It verifies session JWTs against the primary's PUBLIC JWKS and
# never calls Clerk's Backend API.
#
# NEVER set CLERK_SECRET_KEY or CLERK_WEBHOOK_SIGNING_SECRET on this service.
# The server REFUSES TO START if either is present — whether or not
# CLERK_ENABLED is set, because holding the secret is itself the
# misconfiguration. Clerk secrets and webhooks live in timpager only.
# =============================================================================

# Kill switch. "1" enables Rally sign-in; anything else is OFF.
# While off: /auth/clerk/exchange answers 404, no Bearer token is honoured, and
# the login screens are byte-identical to today's.
CLERK_ENABLED=0

# The Rally primary's issuer, matched EXACTLY (not by pattern). Required when
# enabled. Production value is https://clerk.rallytasks.com.
CLERK_JWT_ISSUER=https://clerk.example.com

# azp allowlist: CSV of exact origins allowed to present tokens. Required when
# enabled — without it any app on the primary instance could mint tokens this
# server would honour. A token with no azp is always refused.
CLERK_AUTHORIZED_PARTIES=https://app.example.com,https://example.com

# Publishable key (safe to expose). Must match VITE_CLERK_PUBLISHABLE_KEY.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# The satellite's Clerk Frontend API host. Used ONLY to widen the
# Content-Security-Policy (which is set in server.go, so this has to be a
# backend variable). The CSP is unchanged unless this AND CLERK_ENABLED=1 are
# both set.
CLERK_FRONTEND_API_ORIGIN=https://clerk.example.com

# -----------------------------------------------------------------------------
# Frontend (Vite, read at BUILD time from the frontend/ environment)
# -----------------------------------------------------------------------------
# Empty = Rally sign-in off: @clerk/clerk-react is never loaded, the entry
# bundle is unchanged, and no "Continue with Rally" button renders. When set it
# must equal CLERK_PUBLISHABLE_KEY above.
VITE_CLERK_PUBLISHABLE_KEY=
# This satellite's domain and the primary's sign-in page. Both are required when
# the key is set; if either is missing the app renders WITHOUT Clerk and warns,
# so a half-configured build cannot lock anyone out.
VITE_CLERK_DOMAIN=example.com
VITE_CLERK_SIGN_IN_URL=https://primary.example.com/sign-in
# CSV of origins Clerk may redirect back to. Defaults to the current origin.
VITE_ALLOWED_REDIRECT_ORIGINS=https://app.example.com