# Placeholder values only. Never commit real secrets.

# --- Core ---
PORT=8080
DATABASE_URL=postgres://localhost:5432/pennyai?sslmode=disable
# Public address of the app. Falls back to WEBHOOK_BASE_URL, then to
# https://groflo.rallytasks.com. No trailing slash needed.
APP_BASE_URL=https://groflo.rallytasks.com
# Base URL Twilio/SendGrid call back on. When set, inbound webhook signatures
# are enforced, so TWILIO_AUTH_TOKEN must also be set.
WEBHOOK_BASE_URL=https://groflo.rallytasks.com
NPS_INTERVAL_DAYS=90

# --- Rally sign-in (Clerk). The only consumer sign-in method. ---
# pennyai verifies Clerk session tokens against the issuer's PUBLIC JWKS and
# never calls Clerk's Backend API.
# NEVER set CLERK_SECRET_KEY or CLERK_WEBHOOK_SIGNING_SECRET on this service.
# The server refuses to start if either is present.
#
# "1" enables sign-in. If it is not 1 (and TEST_MODE is off) nobody can sign in,
# and the server logs a warning at boot. With "1", a bad value below stops the
# server at boot so the deploy fails its healthcheck.
CLERK_ENABLED=1
# Exact issuer (not a pattern). Required when enabled.
CLERK_JWT_ISSUER=https://clerk.example.com
# CSV of exact origins allowed as the token's azp. Required when enabled.
CLERK_AUTHORIZED_PARTIES=https://app.example.com
# Clerk Frontend API origin. Only widens the Content-Security-Policy
# (script-src, connect-src, frame-src, worker-src) when CLERK_ENABLED=1.
CLERK_FRONTEND_API_ORIGIN=https://clerk.example.com

# --- Admin (server-side checks only) ---
# Admin if the session phone equals ADMIN_PHONE (10 digits) ...
ADMIN_PHONE=xxxxxxxxxx
# ... or the user's Clerk user id is in this comma-separated list.
ADMIN_CLERK_USER_IDS=user_xxxxxxxxxxxxxxxx

# --- SMS (Twilio). Optional: with any of these missing, SMS is OFF and the
# server logs a warning. Sign-in does not use Twilio. ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- Other services ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LOGODEV_TOKEN=pk_xxxxxxxxxxxxxxxx
LOGODEV_SECRET=sk_xxxxxxxxxxxxxxxx
GOOGLE_PLACES_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

# --- Tests only ---
# TEST_MODE=true registers POST /auth/test-login and replaces Twilio with a
# logger that never sends. The server REFUSES TO START if TEST_MODE=true while
# RAILWAY_ENVIRONMENT_NAME is set. Never set it on a deployed service.
# TEST_MODE=true

# --- Frontend (Vite, read at BUILD time from the frontend/ environment) ---
# Empty = the Clerk SDK is not loaded.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
VITE_CLERK_DOMAIN=example.com
VITE_CLERK_SIGN_IN_URL=https://example.com/sign-in
